#!/bin/bash
# Print all libraries built from $FOAM_SRC which exist in $FOAM_LIBBIN.
# Usage: printOFLibs <bashrc>
# (set MANUAL to print bare library names instead of a semicolon-separated path list)

ARG_BRC=$1
shift 1
source $ARG_BRC
EXPR='^ *LIB *= *$(FOAM_LIBBIN)/\(.*\)$'

# grep all Make/files at once instead of forking grep/sed for each directory
find "$FOAM_SRC" -path "*/Make/files" -type f -exec grep -h -o "$EXPR" {} + 2>/dev/null \
| sed -e "s#$EXPR#\\1#g" \
| (
 while IFS= read -r libbn; do
  if [[ "${libbn}" != "" ]] && [[ "${libbn}" != *"/"* ]]; then
   lib=$FOAM_LIBBIN/${libbn}.so
   if [ -e "$lib" ]; then
    echo $lib
   fi
  fi
 done
) \
| if [ "$MANUAL" ]; then sed -e 's#^.*/lib\([^/]*\)\.so *$#\1#g'; else ( tr '\n' ';' | sed -e 's/;$//')  fi
